# MongoDB
MONGODB_URI=mongodb://localhost:27017/recipe-hub

# Groq (optional; used when AI settings key is empty — local dev / seed)
GROQ_API_KEY=

# Pollinations (optional) — free account token from auth.pollinations.ai enables nologo on provider images
# POLLINATIONS_TOKEN=
# Set POLLINATIONS_WATERMARK_CROP=0 to disable bottom-strip crop on served recipe images

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin seed (optional, used by seed script)
ADMIN_EMAIL=admin@recipehub.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# App
NODE_ENV=development
# Local `npm run dev` uses 3000. Production `npm start` binds 3013 (nginx upstream).
PORT=3013
UPLOAD_DIR=uploads
# VPS/production: set your public API domain so imageUrl is a full URL in API responses.
# Example: https://recipehubapi.com
# Formula: imageUrl = PUBLIC_APP_URL + /uploads/ + imagePath
# imagePath in DB stays relative, e.g. recipes/30172dca-2987-4982-8bc5-6b266d16f407.png
PUBLIC_APP_URL=
