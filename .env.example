# MongoDB
MONGODB_URI=mongodb://localhost:27017/recipe-hub

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin seed (optional, used by seed script)
ADMIN_EMAIL=admin@recipehub.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# App
NODE_ENV=development
# Local default. VPS systemd sets PORT=3013 and can use `npm run start:vps`.
PORT=3000
UPLOAD_DIR=uploads
# Public origin for imageUrl in API responses (optional; falls back to request Host)
# Leave unset locally so imageUrl uses the request Host (localhost).
PUBLIC_APP_URL=
