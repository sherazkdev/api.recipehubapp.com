# MongoDB
MONGODB_URI=mongodb://localhost:27017/recipe-hub

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Admin seed (optional, used by seed script)
ADMIN_EMAIL=admin@recipehub.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

# App
NODE_ENV=development
PORT=3013
UPLOAD_DIR=uploads
# Public origin for imageUrl in API responses (optional; falls back to request Host)
PUBLIC_APP_URL=https://recipehubapi.com
